# Copy to backend/.env and adjust. Every setting is optional in dev.

# dev | test | prod. In prod, SECRET_KEY must be unique and at least 32 characters, and
# COOKIE_SECURE must be true.
ENV=dev
LOG_LEVEL=INFO

# SQLite by default; Postgres: postgresql+psycopg://user:pass@host:5432/jetstream
# (install with `uv sync --extra postgres`).
DATABASE_URL=sqlite:///./jetstream.db

# Auth. Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MIN=720
COOKIE_NAME=js_session
COOKIE_SECURE=false
INVITE_TTL_DAYS=7

# Uploads
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=50
# Per email upload: PDF attachments processed, and their total pages.
MAX_ATTACHMENTS=10
MAX_TOTAL_PAGES=200

# Extraction: auto uses Claude when ANTHROPIC_API_KEY is set, rules otherwise.
EXTRACTOR=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_TIMEOUT_S=120
CLAUDE_MAX_RETRIES=2
CLAUDE_SERVER_FALLBACK=true

# inline runs extraction inside the upload request; background is recommended with Claude.
PIPELINE_MODE=inline
# At startup, documents pending/processing longer than this are marked failed (reprocessable).
STALE_DOCUMENT_MINUTES=15
# Used to build share and invite links.
PUBLIC_APP_URL=http://localhost:3001
DEFAULT_REVIEW_THRESHOLD=75
SHARE_LINK_TTL_DAYS=30

# Rate limits (attempts per window, per client IP)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=60
PUBLIC_RATE_LIMIT=60
PUBLIC_RATE_WINDOW_S=60
# Per account: after this many failed logins, a backoff of 1 s doubling up to the max
# (never a lockout). A successful login clears it.
LOGIN_BACKOFF_AFTER=5
LOGIN_BACKOFF_MAX_S=30

# Comma-separated IPs or CIDRs whose X-Forwarded-For header is trusted (the Next server or
# load balancer in front of this API). The client IP keys rate limits and audit entries.
TRUSTED_PROXIES=127.0.0.1,::1

# Comma-separated. Leave empty: the dashboard proxies /api through Next, so no CORS is needed.
CORS_ORIGINS=
